# sway settings for the display. pi/install.sh writes ~/.config/sway/config,
# which includes this file and then starts kiosk/launch.py.

# Windows meet edge to edge: no borders, title bars or gaps.
default_border none
default_floating_border none
hide_edge_borders both
gaps inner 0
workspace_layout default

output * bg #000000 solid_color

# Touch belongs to the monitor's own panel.
input type:touch map_to_output HDMI-A-1
# The monitor also presents a mouse that mirrors touches; it only adds a
# stray pointer.
seat * hide_cursor 1000
focus_follows_mouse no

# No idle timeout is configured on purpose. The Xeneon Edge disconnects its
# touch controller when the picture stops, so the screen must never blank.
